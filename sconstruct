import os
import os.path
import re
import sys
from pathlib import Path
from collections.abc import Iterable
from typing import Final

# While names imported below are available by default in every SConscript
# Linters aren't aware about them.
# To avoid PyRight `reportUndefinedVariable` errors about them they are imported explicitly.
# When using other  Scons functions please add them to the line below.
from SCons.Script import EnsurePythonVersion, Variables, BoolVariable, Environment, Copy, Action

# Imports for type hints
from SCons.Node import FS

# Add-on localization exchange facility and the template requires Python 3.10.
# For best practice, use Python 3.11 or later to align with NVDA development.
EnsurePythonVersion(3, 10)

# Bytecode should not be written for build vars module to keep the repository root folder clean.
sys.dont_write_bytecode = True

import buildVars  # NOQA: E402


def validateVersionNumber(key: str, val: str, _):
	# Used to make sure version major.minor.patch are integers to comply with NV Access add-on store.
	# Ignore all this if version number is not specified.
	if val == "0.0.0":
		return
	versionNumber = val.split(".")
	if len(versionNumber) < 3:
		raise ValueError(f"{key} must have three parts (major.minor.patch)")
	if not all([part.isnumeric() for part in versionNumber]):
		raise ValueError(f"{key} (major.minor.patch) must be integers")


def expandGlobs(patterns: Iterable[str], rootdir: Path = Path(".")) -> list[FS.Entry]:
	return [env.Entry(e) for pattern in patterns for e in rootdir.glob(pattern.lstrip('/'))]


_projectIdVersion = re.compile(r'^"Project-Id-Version:[^"]*"$', re.MULTILINE)


def stampGettextVersion(files: Iterable[Path], packageName: str, version: str) -> list[Path]:
	"""Rewrite the Project-Id-Version header of the given pot and po files.

	xgettext writes that header only when the pot is regenerated and msgmerge preserves whatever
	a po file already carried, so a version bump in buildVars reaches neither on its own. Files
	are left untouched when the header already matches, so translations do not get needlessly
	recompiled. Returns the paths that were actually rewritten.
	"""
	header = f'"Project-Id-Version: {packageName} {version}\\n"'
	stamped = []
	for file in files:
		if not file.is_file():
			continue
		# newline="" on both ends so the rewrite cannot convert the line endings of the whole file.
		with file.open("r", encoding="utf-8", newline="") as f:
			text = f.read()
		# A lambda as the replacement keeps re from interpreting the \n of the header as an escape.
		newText = _projectIdVersion.sub(lambda _match: header, text, count=1)
		if newText == text:
			continue
		with file.open("w", encoding="utf-8", newline="") as f:
			f.write(newText)
		stamped.append(file)
	return stamped


_potCreationDate = re.compile(r'^"POT-Creation-Date:[^"]*"$', re.MULTILINE)
_authorParts = re.compile(r"^(?P<name>.*?)\s*<(?P<email>[^>]*)>\s*$")


def normalizeGettextHeader(potFile: Path, addonInfo: dict) -> None:
	"""Replace the header xgettext writes on a pot with the one this add-on wants.

	xgettext fills the header of a pot from a fixed template, and it does so afresh
	every time the pot is regenerated, so anything edited into that header by hand
	lasts exactly until the next `scons pot`. Some of the fields can be supplied on
	the command line and some cannot, and a header assembled from two mechanisms at
	once is the sort of thing that drifts quietly, so the whole block is written
	here instead, from the values already in buildVars.

	Only the header is touched; the messages below it are xgettext's own work and
	are left exactly as they were found. The creation date is carried over rather
	than rewritten, being the one field only xgettext is in a position to know.

	The fields describing the package are filled in, and the fields describing the
	translator are deliberately not: a pot is a template that has not been
	translated by anybody, and each po fills those in with whoever translated it.
	Putting a name in them here would only have every translation start out
	claiming to be that person's work.
	"""
	from datetime import date

	# newline="" on both ends, so that rewriting the header cannot convert the line
	# endings of the whole file.
	with potFile.open("r", encoding="utf-8", newline="") as f:
		text = f.read()
	eol = "\r\n" if "\r\n" in text else "\n"
	# The header is a message like any other, so it ends where the first one does:
	# at the blank line before the next. Anything after that separator is messages.
	separator = eol * 2
	end = text.find(separator)
	body = text[end + len(separator) :] if end != -1 else ""

	parts = _authorParts.match(addonInfo["addon_author"])
	authorName = parts["name"] if parts else addonInfo["addon_author"]
	creationDate = _potCreationDate.search(text)
	header = [
		f"# {addonInfo['addon_summary']} NVDA Add-on",
		f"# Copyright (C) {date.today().year} {authorName}",
		"# This file is distributed under the same license as the add-on package.",
		# Gettext's placeholder, left alone: this line credits the translator, and a
		# pot has not been translated by anyone. It is filled in by each po.
		"# FIRST AUTHOR <EMAIL@ADDRESS>, YEAR.",
		"#",
		# The header of a pot is marked fuzzy by convention, so that a po copied from
		# it does not pass its placeholder values off as a finished translation.
		"#, fuzzy",
		'msgid ""',
		'msgstr ""',
		f'"Project-Id-Version: {addonInfo["addon_name"]} {addonInfo["addon_version"]}\\n"',
		creationDate.group(0) if creationDate else '"POT-Creation-Date: \\n"',
		# A translator field like the credit line above, and a placeholder for the
		# same reason. msgmerge never copies it over a po that has a real one.
		'"Last-Translator: FULL NAME <EMAIL@ADDRESS>\\n"',
		'"Language: \\n"',
		'"MIME-Version: 1.0\\n"',
		'"Content-Type: text/plain; charset=UTF-8\\n"',
		'"Content-Transfer-Encoding: 8bit\\n"',
	]
	with potFile.open("w", encoding="utf-8", newline="") as f:
		f.write(eol.join(header) + separator + body)


addonDir: Final = Path("addon/")
localeDir: Final = addonDir / "locale"
docsDir: Final = addonDir / "doc"


vars = Variables()
vars.Add("version", "The version of this build", buildVars.addon_info["addon_version"])
vars.Add("versionNumber", "Version number of the form major.minor.patch", "0.0.0", validateVersionNumber)
vars.Add(BoolVariable("dev", "Whether this is a daily development version", False))
vars.Add("channel", "Update channel for this build", buildVars.addon_info["addon_updateChannel"])

env = Environment(variables=vars, ENV=os.environ, tools=["gettexttool", "NVDATool"])
env.Append(
	addon_info=buildVars.addon_info,
	brailleTables=buildVars.brailleTables,
	symbolDictionaries=buildVars.symbolDictionaries,
)

if env["dev"]:
	from datetime import date

	versionTimestamp = date.today().strftime('%Y%m%d')
	version = f"{versionTimestamp}.0.0"
	env["addon_info"]["addon_version"] = version
	env["versionNumber"] = version
	env["channel"] = "dev"
elif env["version"] is not None:
	env["addon_info"]["addon_version"] = env["version"]
if "channel" in env and env["channel"] is not None:
	env["addon_info"]["addon_updateChannel"] = env["channel"]

# This is necessary for further use in formatting file names.
env.Append(**env["addon_info"])


addonFile = env.File("${addon_name}-${addon_version}.nvda-addon")
addon = env.NVDAAddon(addonFile, env.Dir(addonDir), excludePatterns=buildVars.excludedFiles)

# Keep the version the translation files advertise in step with buildVars, so that bumping it
# there is the only edit a release needs: everything else that names the version (the manifest,
# the html titles, the built package) is already generated from the same value. This is done
# while the SConscript is read rather than as a build action, so that a po file rewritten here is
# already current when scons scans it and still recompiles its mo in the same run. The declared
# version is used rather than env's, because a dev or `version=` build is a one-off that has no
# business rewriting files in the repository.
stampGettextVersion(
	[Path(f"{buildVars.addon_info['addon_name']}.pot"), *sorted(localeDir.glob("*/LC_MESSAGES/nvda.po"))],
	buildVars.addon_info["addon_name"],
	buildVars.addon_info["addon_version"],
)

langDirs: list[FS.Dir] = [env.Dir(d) for d in env.Glob(localeDir/"*/") if d.isdir()]

# Allow all NVDA's gettext po files to be compiled in source/locale, and manifest files to be generated
moByLang: dict[str, FS.File] = {}
for dir in langDirs:
	poFile = dir.File(os.path.join("LC_MESSAGES", "nvda.po"))
	moTarget = env.gettextMoFile(poFile)
	moFile = env.File(moTarget[0])
	moByLang[dir.name] = moFile
	env.Depends(moTarget, poFile)
	translatedManifest = env.NVDATranslatedManifest(
		dir.File("manifest.ini"), [moFile, "manifest-translated.ini.tpl"]
	)
	env.Depends(translatedManifest, ["buildVars.py"])
	env.Depends(addon, [translatedManifest, moTarget])

pythonFiles = expandGlobs(buildVars.pythonSources)
for file in pythonFiles:
	env.Depends(addon, file)

# Convert markdown files to html
# We need at least doc in English and should enable the Help button for the add-on in Add-ons Manager
if (cssFile := Path("style.css")).is_file():
	cssPath = docsDir / cssFile
	cssTarget = env.Command(str(cssPath), str(cssFile), Copy("$TARGET", "$SOURCE"))
	env.Depends(addon, cssTarget)

if (readmeFile := Path("readme.md")).is_file():
	readmePath = docsDir / buildVars.baseLanguage / readmeFile
	readmeTarget = env.Command(str(readmePath), str(readmeFile), Copy("$TARGET", "$SOURCE"))
	env.Depends(addon, readmeTarget)

for mdFile in env.Glob(docsDir/"*/*.md"):
	# the title of the html file is translated based on the contents of something in the moFile for a language.
	# Thus, we find the moFile for this language and depend on it if it exists.
	lang = mdFile.dir.name
	moFile = moByLang.get(lang)
	htmlFile = env.md2html(mdFile, moFile=moFile, mdExtensions=buildVars.markdownExtensions)
	env.Depends(htmlFile, mdFile)
	# The title also carries the add-on version, which lives in neither the markdown nor the mo
	# file, so a version bump on its own has to invalidate the generated html as well.
	env.Depends(htmlFile, env.Value(env["addon_info"]["addon_version"]))
	if moFile:
		env.Depends(htmlFile, moFile)
	env.Depends(addon, htmlFile)

# Pot target
i18nFiles = expandGlobs(buildVars.i18nSources)
gettextvars: dict[str, str] = {
	"gettext_package_bugs_address": "nvda-translations@groups.io",
	"gettext_package_name": buildVars.addon_info["addon_name"],
	"gettext_package_version": buildVars.addon_info["addon_version"],
}

pot = env.gettextPotFile("${addon_name}.pot", i18nFiles, **gettextvars)
env.Alias("pot", pot)
env.Depends(pot, i18nFiles)
# Put our own header back the moment xgettext has written its template one, as part of
# building the pot rather than as a step anybody has to remember afterwards. The merge
# pot needs none of this: it is generated with --omit-header and has no header at all.
env.AddPostAction(
	pot,
	Action(
		lambda target, source, env: normalizeGettextHeader(Path(str(target[0])), buildVars.addon_info),
		"Normalising the header of $TARGET",
	),
)
mergePot = env.gettextMergePotFile("${addon_name}-merge.pot", i18nFiles, **gettextvars)
env.Alias("mergePot", mergePot)
env.Depends(mergePot, i18nFiles)

# Propagate the regenerated pot into every existing translation.
# msgmerge keeps the translations already made, marks any entry whose English
# source string changed as fuzzy so the translator revisits exactly those, and
# drops entries that no longer exist in the source. Together with the pot target
# above this is what keeps the `_()` call in the Python source the only place an
# English string ever has to be edited.
poFiles = [dir.File(os.path.join("LC_MESSAGES", "nvda.po")) for dir in langDirs]
updatePo = env.Alias(
	"updatePo",
	pot,
	[
		Action(
			f'msgmerge --update --backup=none --previous "{po.path}" $SOURCE',
			f"Updating translation {po.path}",
		)
		for po in poFiles
	],
)
# The po files are updated in place, so there is no target whose timestamp scons
# could compare; always run the merge when the target is asked for.
env.AlwaysBuild(updatePo)

# Generate Manifest path
manifest = env.NVDAManifest(env.File(addonDir/"manifest.ini"), "manifest.ini.tpl")
# Ensure manifest is rebuilt if buildVars is updated.
env.Depends(manifest, "buildVars.py")

env.Depends(addon, manifest)
env.Default(addon)
env.Clean(addon, [".sconsign.dblite", "addon/doc/" + buildVars.baseLanguage + "/"])
